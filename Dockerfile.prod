# Multi-Stage Production Dockerfile
# Stage 1: Install dependencies with clean cache
FROM node:20-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Stage 2: Build the static frontend application
FROM node:20-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Set production environment and build
ENV NODE_ENV=production
RUN npm run build

# Stage 3: Minimal production runtime with Nginx (<150MB, typically ~25-40MB)
FROM nginx:alpine AS runner

# Copy custom Nginx configuration with SPA fallback, compression & security headers
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static artifacts only (excludes node_modules and dev source)
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
